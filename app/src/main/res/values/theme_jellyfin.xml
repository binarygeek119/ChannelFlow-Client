<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Jellyfin" parent="@style/Theme.AppCompat.Leanback">
        <!-- Colors -->
        <item name="android:colorPrimary">@color/channelflow_drawer</item>
        <item name="android:colorPrimaryDark">@color/channelflow_page</item>
        <item name="android:colorAccent">@color/channelflow_accent</item>
        <item name="android:colorControlActivated">@color/channelflow_accent</item>
        <item name="defaultBrandColor">@color/channelflow_accent</item>
        <item name="defaultBrandColorDark">@color/channelflow_accent_pressed</item>
        <!-- Background resource or color -->
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="defaultBackground">@color/channelflow_page</item>
        <!-- Background color for CardViews -->
        <item name="cardImageBackground">@color/channelflow_card</item>
        <item name="cardViewBackground">@android:color/transparent</item>
        <!-- Search FAB color -->
        <item name="defaultSearchColor">@color/channelflow_accent</item>
        <!-- Default (non-active) button color -->
        <item name="android:colorButtonNormal">@color/channelflow_nav</item>
        <item name="buttonDefaultNormalBackground">@color/button_default_normal_background</item>
        <item name="buttonDefaultHighlightBackground">@color/channelflow_accent</item>
        <!-- Default (non-active) input -->
        <item name="inputDefaultStrokeWidth">2dp</item>
        <item name="inputDefaultStrokeColor">@color/channelflow_border</item>
        <item name="inputDefaultHighlightBackground">@color/channelflow_accent</item>
        <!-- Default popup menu -->
        <item name="popupMenuBackground">@color/channelflow_drawer</item>
        <!-- Header text color -->
        <item name="headerTextColor">@color/channelflow_text</item>

        <!-- Progress Bar -->
        <item name="progressBackground">@color/grey_transparent</item>
        <item name="progressPrimary">@color/channelflow_accent</item>
        <item name="progressSecondary">@color/channelflow_accent_hover</item>

        <!-- Custom Styles for Elements -->
        <item name="android:datePickerStyle">@style/DatePickerCustom</item>
        <item name="rowHeaderStyle">@style/Widget.Jellyfin.Row.Header</item>
        <item name="browseTitleViewLayout">@layout/view_lb_browse_title</item>

        <item name="android:popupMenuStyle">@style/PopupMenu</item>
        <item name="android:popupWindowStyle">@style/PopupWindow</item>

        <!-- Rounding Values -->
        <item name="cardRounding">8dp</item>
        <item name="buttonRounding">8dp</item>
        <item name="inputRounding">8dp</item>
        <item name="popupMenuRounding">8dp</item>

        <!-- Dim level of non-focus grid items -->
        <item name="overlayDimDimmedLevel">30%</item>

        <!-- Control icons -->
        <item name="controlIconBackground">@color/channelflow_nav</item>
        <item name="controlIconForegroundActive">@color/channelflow_accent</item>
        <item name="controlIconForegroundInactive">@color/channelflow_muted</item>

        <!-- QR drawables -->
        <item name="qrBackground">@color/white</item>
        <item name="qrForeground">@color/channelflow_accent</item>

        <!-- Tile colors -->
        <item name="tile_port_person_bg">@color/channelflow_accent_pressed</item>
        <item name="tile_port_video_bg">@color/channelflow_accent_pressed</item>
        <item name="tile_land_folder_bg">@color/channelflow_accent_pressed</item>
        <item name="tile_chapter_bg">@color/channelflow_accent_pressed</item>
        <item name="tile_land_tv_bg">@color/channelflow_accent_pressed</item>
        <item name="tile_port_tv_bg">@color/channelflow_accent_pressed</item>
        <item name="tile_actors_bg">@color/channelflow_accent_pressed</item>
        <item name="tile_land_photo_bg">@color/channelflow_accent_pressed</item>
        <item name="tile_port_folder_bg">@color/channelflow_accent_pressed</item>
        <item name="tile_land_series_timer_bg">@color/channelflow_accent_pressed</item>

        <item name="tile_audio_bg">@color/channelflow_drawer</item>
        <item name="tile_artists_bg">@color/channelflow_accent</item>
        <item name="tile_genres_bg">@color/channelflow_drawer</item>
        <item name="tile_search_bg">@color/channelflow_accent</item>

        <item name="tile_suggestions_bg">@color/channelflow_accent</item>
        <item name="tile_port_grid_bg">@color/channelflow_drawer</item>
        <item name="tile_letters_bg">@color/channelflow_accent</item>

        <item name="tile_port_guide_bg">@color/channelflow_accent</item>
        <item name="tile_port_series_timer_bg">@color/channelflow_drawer</item>
        <item name="tile_port_time_bg">@color/channelflow_accent</item>

        <item name="android:dialogTheme">@style/Theme.Jellyfin.Dialog</item>
    </style>

    <style name="Theme.Jellyfin.Dialog" parent="Theme.AppCompat.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
