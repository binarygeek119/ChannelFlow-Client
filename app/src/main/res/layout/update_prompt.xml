<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:background="@drawable/popup_menu_back"
	android:orientation="vertical"
	android:padding="28dp">

	<TextView
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:background="@color/channelflow_accent"
		android:paddingHorizontal="10dp"
		android:paddingVertical="3dp"
		android:text="@string/lbl_update_ready"
		android:textAllCaps="true"
		android:textColor="@color/white"
		android:textSize="12sp"
		android:textStyle="bold" />

	<TextView
		android:id="@+id/title"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="12dp"
		android:fontFamily="sans-serif-light"
		android:textColor="@color/channelflow_text"
		android:textSize="26sp"
		tools:text="v.0.0.3" />

	<TextView
		android:id="@+id/message"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="16dp"
		android:fontFamily="sans-serif-light"
		android:lineSpacingMultiplier="1.15"
		android:text="@string/msg_update_ready"
		android:textColor="@color/channelflow_text"
		android:textSize="16sp" />

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="24dp"
		android:gravity="end"
		android:orientation="horizontal">

		<Button
			android:id="@+id/laterButton"
			style="@style/Button.Default"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginEnd="12dp"
			android:text="@string/lbl_later" />

		<Button
			android:id="@+id/installButton"
			style="@style/Button.Default"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="@string/lbl_install_now" />
	</LinearLayout>
</LinearLayout>
